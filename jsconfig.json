{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "types": ["node", "@wdio/globals/types"],
    "paths": {
      "~/*": ["./*"],
      "page-objects/*": ["./test/page-objects/*.js"]
    }
  },
  "include": [
    "test/**/*.js",
    "wdio.grid.conf.js",
    "wdio.local.conf.js",
    "wdio.browserstack.conf.js"
  ]
}
