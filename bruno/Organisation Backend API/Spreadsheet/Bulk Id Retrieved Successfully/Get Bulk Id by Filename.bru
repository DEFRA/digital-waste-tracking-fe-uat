meta {
  name: Get Bulk Id by Filename
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/test/spreadsheet/{{organisationId}}/uploads?filename={{fileName}}
  body: none
  auth: inherit
}

params:query {
  filename: {{fileName}}
}

headers {
  x-api-key: {{x-api-key}}
}

vars:post-response {
  uploadId: res.body.uploads[0].uploadId
}

settings {
  encodeUrl: true
  timeout: 0
}
