meta {
  name: Get API Codes For An Organisation
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/organisation/{{organisationId}}/apiCodes
  body: none
  auth: inherit
}

headers {
  x-api-key: {{x-api-key}}
}

vars:post-response {
  apiCode: res.body.apiCodes[0].code
}

settings {
  encodeUrl: true
  timeout: 0
}
