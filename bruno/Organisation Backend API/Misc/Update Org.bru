meta {
  name: Update Org
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/user/{{userId}}/organisation/{{organisationId1}}
  body: json
  auth: inherit
}

headers {
  content-type: application/json
  x-api-key: {{x-api-key}}
  ~authorization: Basic vvxx
}

body:json {
  {
    "organisation": {
      "name": "Some Org1",
      "users": [
        "{{userId}}"
      ],
      "isLocalAuthority":true
    }
  }
  
}

vars:pre-request {
  userId: {{$randomUUID}}
  organisationId1: {{$randomUUID}}
}

settings {
  encodeUrl: false
  timeout: 0
}
